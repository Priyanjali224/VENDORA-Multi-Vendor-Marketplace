# VENDORA Monorepo .gitignore
# Dependencies
node_modules/
.pnp
.pnp.js

# Production builds
dist/
build/

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Editor & OS files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Uploads and temporary data
backend/uploads/*
!backend/uploads/.gitkeep
temp/
coverage/

# Database files
*.sqlite
*.db
# Environment files
.env.*
!.env.example
!.env.*.example

# Frontend and backend dependencies
backend/node_modules/
frontend/node_modules/

# Build files
backend/dist/
frontend/dist/

# Secrets and local configuration
*.pem
*.key

